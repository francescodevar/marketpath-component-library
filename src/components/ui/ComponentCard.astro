---
import { previewDocument } from '../../lib/utils.js';

const { component } = Astro.props;
const searchableText = [
  component.name,
  component.category,
  component.id,
  component.description,
  ...component.tags,
].join(' ').toLowerCase();
---

<article
  class="component-card"
  data-component
  data-category={component.category}
  data-search={searchableText}
>
  <button class="card-preview-button" data-open={component.id} aria-label={`Preview ${component.name}`}>
    <div class="preview-chrome" aria-hidden="true"><span class="chrome-dots"><i></i><i></i><i></i></span><span class="chrome-label">Component preview</span><span class="expand-icon">⤢</span></div>
    <div class="card-preview"><iframe tabindex="-1" inert loading="lazy" sandbox="" title={`${component.name} thumbnail`} srcdoc={previewDocument(component, { bootstrap: false })}></iframe></div>
  </button>
  <div class="card-info">
    <h2><button data-open={component.id}>{component.name}</button></h2>
    <p class="card-description">{component.description}</p>
  </div>
</article>
